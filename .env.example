# Copy this file to .env.local for local development. Never commit the real
# .env.local — it's already covered by .gitignore. On Vercel/Netlify, set
# these as dashboard environment variables instead of committing a file.

# --- Data access layer -------------------------------------------------
# Which DataStore implementation to use. "google-sheets" is the only
# built-in implementation today; the app talks to it exclusively through
# the DataStore interface (src/lib/data-access/DataStore.ts), so a future
# backend only needs a new implementation of that interface plus a new
# case in src/lib/data-access/index.ts.
DATA_STORE_PROVIDER=google-sheets

# --- Google Sheets (google-sheets provider) -----------------------------
# Service account credentials with edit access to the target spreadsheet.
# Create a service account in Google Cloud Console, enable the Sheets API,
# then share the target Sheet with the service account's email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the service account private key. Keep the \n escape sequences as-is
# (the app un-escapes them at runtime) rather than a real multi-line value.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# --- Photo storage (Google Drive implementation) -------------------------
# Uploaded costume photos are stored in a folder inside a personal Google
# Drive — NOT via the service account above. A bare service account cannot
# own Drive files (or write into a personal folder shared with it) outside
# a Google Workspace Shared Drive, and personal Gmail accounts don't have
# Shared Drives available. So the app instead authenticates as a real
# Google account via OAuth for photo uploads only; that account then owns
# every uploaded photo outright (no separate "share with me" step needed).
#
# One-time setup:
#   1. Create an OAuth 2.0 Client ID (type: Desktop app) in the same Google
#      Cloud project as your service account. Set the two values below.
#   2. Create (or pick an existing) folder in that Google account's Drive
#      for photos to land in, and set its id below. To get a folder's id,
#      open it in Drive and copy the id from the URL:
#      drive.google.com/drive/folders/<this-part-is-the-id>
#   3. Run `npm run drive:auth` and follow the printed instructions to fill
#      in GOOGLE_OAUTH_REFRESH_TOKEN.
# See README.md for details.
PHOTO_STORAGE_PROVIDER=google-drive
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=filled-in-by-npm-run-drive-auth
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=your-drive-folder-id

# --- Voter phone verification (Twilio Verify) ------------------------------
# Gates vote SUBMISSION only (not browsing nominees) behind a one-time SMS
# code, checked once per browser session. Create a Twilio account and a
# Verify Service in the Twilio Console (twilio.com/console/verify/services),
# then copy the three values below. See README.md for setup steps.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# --- Admin auth -----------------------------------------------------------
# Shared password George/Sarah use to access the private admin panel, and a
# random secret used to sign both the admin session cookie and the voter
# phone-verification session cookie (see src/lib/auth/voterSession.ts).
# Generate a long random value for SESSION_SECRET (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# --- Optional: runtime config overrides -----------------------------------
# Everything in config/site.config.json can alternatively be supplied here,
# which is useful on hosts where committing even a gitignored local file is
# inconvenient (e.g. a fresh Vercel deploy). Env vars take precedence over
# the file. Uncomment and fill in as needed; see src/lib/config/index.ts for
# the full list.
# SITE_EVENT_NAME=Thriller Night
# SITE_EVENT_THEME_NAME=Your Movie Theme Here
# SITE_EVENT_DATE=2026-10-31
# SITE_EVENT_ARRIVAL_TIME=7:00 PM
# SITE_EVENT_END_TIME=11:00 PM
# SITE_EVENT_TAGLINE=Everyone wears a costume.
# SITE_INVITATION_MODULE_ENABLED=false
# SITE_VOTING_MODULE_ENABLED=true
